+                "[DSUM-SUMMARY] formatting_error",
+                Cnr3StderrFlushPolicy::no_flush
+            );
+            return;
+        }
+
+        used = static_cast<std::size_t>(written);
+        if (used >= sizeof(message)) {
+            used = sizeof(message) - 1U;
+        }
+
+        for (std::size_t i = 0U; i < count && (start + i) < values.size(); ++i) {
