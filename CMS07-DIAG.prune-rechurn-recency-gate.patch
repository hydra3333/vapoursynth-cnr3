 inline constexpr int CNR3_CACHE_BOUNDED_RECOVERY_BACK_RADIUS =
     CNR3_CACHE_HOT_ZONE_BACK_RADIUS;
 
+// Recency bound for the prune-rechurn counter, in eviction-count units, not frame numbers.
+// A re-fetched frame counts as recently evicted only if no more than this many evictions
+// occurred after it was dropped. Derived from BACK_RADIUS with small bursting slack so the
+// counter tracks prune-policy churn without re-admitting stale far-revisit noise.
+inline constexpr std::uint64_t CNR3_PRUNE_RECHURN_MAX_EVICTION_GAP =
+    static_cast<std::uint64_t>(CNR3_CACHE_HOT_ZONE_BACK_RADIUS) + 2U;
+
