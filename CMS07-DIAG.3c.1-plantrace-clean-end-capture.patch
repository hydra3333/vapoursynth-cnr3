+
+    void cnr3_diag_plantrace_write_view(
+        Cnr3InstanceId instance_id,
+        std::vector<Cnr3DiagPlanTraceRecord> records,
+        Cnr3DiagPlanTraceView view,
+        Cnr3DiagPlanTraceTick anchor_tick,
+        long long anchor_epoch_ms
+    ) noexcept {
+        const char* view_name = "unknown";
+        const char* sort_name = "unknown";
+
+        switch (view) {
+        case Cnr3DiagPlanTraceView::datetime:
+            view_name = "DATETIME";
+            sort_name = "enter_tick ASC, action_seq ASC";
+            std::sort(
+                records.begin(),
+                records.end(),
+                [](const auto& left, const auto& right) noexcept {
+                    if (left.enter_tick != right.enter_tick) {
+                        return left.enter_tick < right.enter_tick;
+                    }
+                    return left.action_seq < right.action_seq;
+                }
+            );
+            break;
+        case Cnr3DiagPlanTraceView::frame:
+            view_name = "FRAME";
+            sort_name = "frame ASC, phase ASC, action_seq ASC";
+            std::sort(
+                records.begin(),
+                records.end(),
+                [](const auto& left, const auto& right) noexcept {
+                    if (left.frame_number != right.frame_number) {
+                        return left.frame_number < right.frame_number;
+                    }
+                    const int left_phase = cnr3_diag_plantrace_phase_sort_value(left.phase);
+                    const int right_phase = cnr3_diag_plantrace_phase_sort_value(right.phase);
+                    if (left_phase != right_phase) {
+                        return left_phase < right_phase;
+                    }
+                    return left.action_seq < right.action_seq;
+                }
+            );
+            break;
+        case Cnr3DiagPlanTraceView::phase:
+            view_name = "PHASE";
+            sort_name = "phase ASC, frame ASC, action_seq ASC";
+            std::sort(
+                records.begin(),
+                records.end(),
+                [](const auto& left, const auto& right) noexcept {
+                    const int left_phase = cnr3_diag_plantrace_phase_sort_value(left.phase);
+                    const int right_phase = cnr3_diag_plantrace_phase_sort_value(right.phase);
+                    if (left_phase != right_phase) {
+                        return left_phase < right_phase;
+                    }
+                    if (left.frame_number != right.frame_number) {
+                        return left.frame_number < right.frame_number;
+                    }
+                    return left.action_seq < right.action_seq;
+                }
+            );
+            break;
+        }
+
+        const int frame_width = cnr3_diag_plantrace_frame_width();
+        const int action_seq_width = cnr3_diag_plantrace_action_seq_width();
+
+        cnr3_diag_plantrace_write_line(
+            instance_id,
+            std::string{"[DSUM-PLANTRACE] BEGIN view="} + view_name +
+            " sort=(" + sort_name + ")"
+        );
+        cnr3_diag_plantrace_write_legend(instance_id, view_name);
+
+        for (const Cnr3DiagPlanTraceRecord& record : records) {
+            cnr3_diag_plantrace_write_record(
+                instance_id,
+                record,
+                anchor_tick,
+                anchor_epoch_ms,
+                frame_width,
+                action_seq_width
+            );
+        }
+
+        cnr3_diag_plantrace_write_line(
+            instance_id,
+            std::string{"[DSUM-PLANTRACE] END view="} + view_name
+        );
+    }
+
