+void cnr3_format_int_range_expectation(
+    int minimum_value,
+    int maximum_value,
+    char* expectation,
+    std::size_t expectation_size
+) noexcept {
+    if (expectation == nullptr || expectation_size == 0U) {
+        return;
+    }
+
+    std::snprintf(
+        expectation,
+        expectation_size,
+        "an integer in the range %d..%d inclusive.",
+        minimum_value,
+        maximum_value
+    );
+}
+
+void cnr3_format_float_range_expectation(
+    double minimum_value,
+    double maximum_value,
+    char* expectation,
+    std::size_t expectation_size
+) noexcept {
+    if (expectation == nullptr || expectation_size == 0U) {
+        return;
+    }
+
+    std::snprintf(
+        expectation,
+        expectation_size,
+        "a finite float in the range %.1f..%.1f inclusive.",
+        minimum_value,
+        maximum_value
+    );
+}
+
+const char* cnr3_curve_expectation() noexcept {
+    return "exactly \"wide\" or \"narrow\".";
+}
+
+const char* cnr3_bool_expectation() noexcept {
+    return "0 or 1.";
+}
+
+void cnr3_format_type_error_detail(
+    char* detail,
+    std::size_t detail_size,
+    const char* expectation
+) noexcept {
+    if (detail == nullptr || detail_size == 0U) {
+        return;
+    }
+
+    std::snprintf(
+        detail,
+        detail_size,
+        "incorrect value type, expected %s",
+        expectation != nullptr ? expectation : "a valid value."
+    );
+}
+
+void cnr3_format_got_int_error_detail(
+    char* detail,
+    std::size_t detail_size,
+    std::int64_t value,
+    const char* expectation
+) noexcept {
+    if (detail == nullptr || detail_size == 0U) {
+        return;
+    }
+
+    std::snprintf(
+        detail,
+        detail_size,
+        "got %lld, expected %s",
+        static_cast<long long>(value),
+        expectation != nullptr ? expectation : "a valid value."
+    );
+}
+
+void cnr3_format_option_data_echo(
+    const char* value,
+    int value_size,
+    char* echo,
+    std::size_t echo_size
+) noexcept {
+    if (echo == nullptr || echo_size == 0U) {
+        return;
+    }
+
+    echo[0] = '\0';
+
+    if (value == nullptr || value_size < 0) {
+        std::snprintf(echo, echo_size, "<null>");
+        return;
+    }
+
+    std::size_t copy_count = static_cast<std::size_t>(value_size);
+
+    if (copy_count > 0U && value[copy_count - 1U] == '\0') {
+        --copy_count;
+    }
+
+    if (copy_count > 32U) {
+        copy_count = 32U;
+    }
+
+    if (copy_count + 1U > echo_size) {
+        copy_count = echo_size - 1U;
+    }
+
+    for (std::size_t i = 0; i < copy_count; ++i) {
+        const unsigned char ch = static_cast<unsigned char>(value[i]);
+        echo[i] = (ch >= 0x20U && ch <= 0x7eU && ch != '"' && ch != '\\') ?
+            static_cast<char>(ch) :
+            '?';
+    }
+
+    echo[copy_count] = '\0';
+}
