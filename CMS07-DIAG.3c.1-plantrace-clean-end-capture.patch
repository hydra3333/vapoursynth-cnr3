+    [[nodiscard]] std::string cnr3_diag_plantrace_format_frame_list(
+        const std::vector<int>& frames,
+        int frame_width
+    ) {
+        std::string text{"["};
+
+        for (std::size_t i = 0U; i < frames.size(); ++i) {
+            if (i != 0U) {
+                text += ",";
+            }
+
+            text += cnr3_diag_plantrace_format_frame(
+                frames[i],
+                frame_width,
+                true
+            );
